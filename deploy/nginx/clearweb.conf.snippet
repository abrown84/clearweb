    # Clearweb — Tavily-compatible multi-engine search API
    location = /labs/clearweb {
        return 301 /labs/clearweb/;
    }
    # Admin + readiness are localhost-only (app enforces it too).
    location ~ ^/labs/clearweb/(admin|ready)(/|$) {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://127.0.0.1:3055;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location ^~ /labs/clearweb/ {
        proxy_pass http://127.0.0.1:3055/;
        ...  # unchanged
    }
